// NOTE (2026-09-03, rewritten for the T58 parser): the previous version of this file was a
// full Pine v6 strategy (session time() windows, ta.median/ta.barssince, var state variables,
// FVG top/bottom tracking, a full daily-risk/cooldown state machine) written the way you'd
// actually code it for TradingView. None of that is inside the T58 PineScript adapter's
// supported subset (see app/strategy/pinescript.py's module docstring) -- it's a line-based
// parser for a deliberately small set of constructs, not a Pine language implementation, so
// it fails loudly rather than silently mis-backtesting something it can't really read. Trying
// to load the old file raised:
//   StrategyError: unsupported expression on right-hand side of
//   'session1 = not na(time(timeframe.period, "0930-1130", "America/New_York"))'
// This rewrite keeps the same underlying idea -- price sweeps away from value and then
// reclaims it, traded with the higher-timeframe trend -- but expresses it with only what the
// parser actually understands: price refs, ta.sma/ema/wma/rsi, ta.crossover/crossunder, and
// boolean comparisons. What could NOT be preserved because the parser has no equivalent at
// all: session-time windows, liquidity-sweep/FVG detection (needs highest()/lowest()/shifted
// bar refs, none of which this adapter supports), and the daily trade/loss-limit state
// machine (var state + counters aren't supported either -- use RiskConfig.daily_loss_limit_pct
// / max_trades_per_day in the app's own risk settings for that instead, same as every other
// PineScript/MQL5 strategy in this repo). If you want the FULL sweep/FVG/session-state design
// preserved exactly, that needs to be a Python strategy (app/strategy/python.py runs real
// Python, no regex subset limit) -- Winning_Liquidity_Reclaim.py is that version.
//@version=5
strategy("T58 Liquidity Reclaim (Simplified)")

fastLen = input.int(20, "Fast EMA")
slowLen = input.int(100, "Slow EMA")
rsiLen = input.int(14, "RSI Length")

rsiLongMin = input.float(28.0, "Long RSI Minimum")
rsiLongMax = input.float(48.0, "Long RSI Maximum")
rsiShortMin = input.float(52.0, "Short RSI Minimum")
rsiShortMax = input.float(72.0, "Short RSI Maximum")

fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
rsiVal = ta.rsi(close, rsiLen)

// higher-timeframe trend filter (fast EMA vs slow EMA, in place of the
// original's separate 50/200 slope-checked pair -- the parser has no
// concept of "slope over N bars" without shifted refs, so trend is
// expressed the same way trend_pullback.pine already does it)
longTrend = fastEMA > slowEMA
shortTrend = fastEMA < slowEMA

// "reclaim" trigger: price sweeping back across the fast EMA is the closest
// event this parser can express to the original's sweep-then-FVG-fill entry
reclaimUp = ta.crossover(close, fastEMA)
reclaimDown = ta.crossunder(close, fastEMA)

// RSI bands stand in for "just came off an extreme and is recovering" --
// tighter/lower than trend_pullback.pine's continuation bands on purpose,
// since this is a reversion-style reclaim, not a trend-continuation pullback
longMomentum = rsiVal > rsiLongMin and rsiVal < rsiLongMax
shortMomentum = rsiVal > rsiShortMin and rsiVal < rsiShortMax

longCondition = longTrend and reclaimUp and longMomentum
shortCondition = shortTrend and reclaimDown and shortMomentum

exitLongCondition = ta.crossunder(close, fastEMA)
exitShortCondition = ta.crossover(close, fastEMA)

strategy.entry("Long", strategy.long, when=longCondition)
strategy.entry("Short", strategy.short, when=shortCondition)

strategy.close("Long", when=exitLongCondition)
strategy.close("Short", when=exitShortCondition)

// Instrument-scale-independent stop/target (see pinescript.py docstring) --
// the original file's fixed structural stop (sweep low/high +/- ATR buffer)
// isn't expressible without shifted refs either, so this uses the same
// ATR-multiple approach every other strategy in this repo already uses.
// T58_SL_ATR_MULT=1.25
// T58_TP_ATR_MULT=2.0
// T58_ATR_PERIOD=14

//@version=5
strategy("EMA Trend + RSI Pullback", overlay=true)

// T58_SL_PIPS=25
// T58_TP_PIPS=50
//
// DESIGN NOTE (read this before running):
// This is a from-scratch design, built specifically to work within T58's
// actual PineScript parser subset (see app/strategy/pinescript.py) --
// only ta.sma/ema/wma/rsi, ta.crossover/crossunder, and plain comparisons
// over already-defined series are supported. No security()/multi-
// timeframe, no custom functions, no arrays. Every one of the 6 uploaded
// Pine scripts reviewed earlier failed to load for exactly this reason;
// this one is written to actually run tonight.
//
// MECHANISM: trend-following, but entering on a PULLBACK rather than
// chasing a breakout. A 20/50 EMA relationship sets the trend direction;
// RSI dropping below 40 inside an uptrend (or rising above 60 inside a
// downtrend) marks a pullback/rally within that trend -- the entry.
// Exit is active (RSI recovering back through the opposite threshold),
// not purely stop/target-managed, so the strategy can bank a winner on
// its own logic even before the fixed 2:1 target is reached.

emaFast = ta.ema(close, 20)
emaSlow = ta.ema(close, 50)
rsiVal = ta.rsi(close, 14)

uptrend = emaFast > emaSlow
downtrend = emaFast < emaSlow

longCondition = uptrend and rsiVal < 40
shortCondition = downtrend and rsiVal > 60
exitLongCondition = rsiVal > 60
exitShortCondition = rsiVal < 40

if longCondition
    strategy.entry("Long", strategy.long)
if shortCondition
    strategy.entry("Short", strategy.short)

strategy.close("Long", when=exitLongCondition)
strategy.close("Short", when=exitShortCondition)

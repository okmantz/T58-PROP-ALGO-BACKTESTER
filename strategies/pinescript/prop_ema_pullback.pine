//@version=5
// T58_SL_PIPS=20
// T58_TP_PIPS=34

strategy("Prop EMA Pullback Reclaim")

fastLength = input.int(21, "Fast EMA length")
slowLength = input.int(55, "Slow EMA length")
rsiLength = input.int(14, "RSI length")

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)

longCondition = fastEma > slowEma and ta.crossover(close, fastEma) and rsiValue > 52 and rsiValue < 70
shortCondition = fastEma < slowEma and ta.crossunder(close, fastEma) and rsiValue < 48 and rsiValue > 30

exitLongCondition = ta.crossunder(close, fastEma) or rsiValue < 45
exitShortCondition = ta.crossover(close, fastEma) or rsiValue > 55

strategy.entry("Long", strategy.long, when=longCondition)
strategy.entry("Short", strategy.short, when=shortCondition)

strategy.close("Long", when=exitLongCondition)
strategy.close("Short", when=exitShortCondition)
